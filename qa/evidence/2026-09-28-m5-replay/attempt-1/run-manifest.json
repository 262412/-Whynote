    "A": {
      "primary_reason": {
        "type": "choice",
        "instructions": "Why is this answer unsatisfactory? Choose the main reason supported by the text.",
        "criteria": {
          "factual_error": "Incorrect facts or calculation",
          "instruction_not_followed": "Ignores the user's explicit instructions",
          "incomplete": "Missing necessary details or steps",
          "irrelevant": "Does not address the question",
          "style": "Unsuitable tone or presentation",
          "outdated": "Information is out of date",
          "unnecessary_refusal": "Refuses a reasonable request",
          "other_or_unknown": "Other reason or insufficient evidence"
        }
      },
      "factual_error_signal": {
        "type": "noul",
        "instructions": "Does the answer contain a factual or calculation error?"
      },
      "instruction_failure_signal": {
        "type": "noul",
        "instructions": "Does the answer violate explicit user instructions?"
      }
    },
    "B": {
      "route": {
        "type": "choice",
        "instructions": "Choose the single main domain of the user's request.",
        "criteria": {
          "code": "Code rewriting or programming",
          "general": "Other tasks"
        }
      }
    },
    "C": {
      "route": {
        "type": "choice",
        "instructions": "Choose the task in the user's request, preserving negations.",
        "criteria": {
          "code_rewrite": "Rewrite existing code",
          "general": "General non-code task",
          "mixed": "Code rewrite and another task",
          "other": "Other task",
          "unknown": "Insufficient information to identify the task"
        }
      }
    },
    "decision_choices": {
      "yes": "The evidence supports this defect",
      "no": "This defect is not supported",
      "unknown": "Insufficient evidence to judge"
    },
    "reason_instructions": {
      "code.interface_changed": "Select only when the request requires preserving the interface and the original code and answer show a signature, parameter or return-contract change. An explicitly requested interface change is not a defect.",
      "code.behavior_changed": "Select only for a supported behavior change that violates the requested preservation of behavior. Compare the original code with the answer. Do not invent execution results or treat a requested behavior change as an error.",
      "code.incomplete_rewrite": "Select when a requested complete rewrite omits necessary original behavior or implementation. Check the requested output scope. A requested snippet or pseudocode is not an incomplete rewrite.",
      "code.scope_exceeded": "Select only when an explicit scope boundary or prohibition is violated by the proposed rewrite. Preserve negations in the request. Do not infer that every extra change is unwanted.",
      "general.factual_error": "Select a factual or calculation contradiction supported by the supplied reference. Do not guess a fact is false when the evidence is unavailable.",
      "general.instruction_not_followed": "Select a violation of an explicit user instruction, including a negated constraint. Preserve the full instruction and its exceptions; do not infer unstated preferences.",
      "general.incomplete": "Select missing information or steps necessary to satisfy the stated request. Respect requests for summaries or partial output.",
      "general.irrelevant": "Select when the answer primarily addresses a different question. Necessary background that supports a direct answer is not irrelevant.",
      "general.style": "Select a tone or presentation mismatch supported by the stated audience or purpose. Do not substitute the evaluator's unstated stylistic preferences.",
      "general.outdated": "Select outdated information only with a dated or versioned reference and a request that requires that time or version. Historical questions are not automatically outdated.",
      "general.unnecessary_refusal": "Select an unsupported refusal of a reasonable request. A justified refusal or a request for necessary clarification is not an unnecessary refusal; abstain if unsure."
    },
    "fallback": "C general without yes and with original_code: add code once",
    "quality_thresholds": null,
    "purpose": "synthetic_engineering_replay"
  },
