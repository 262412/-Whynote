+"""Whynote S0 server-verified feedback associations and legacy review queue."""
+
+import sqlalchemy as sa
+from alembic import op
+
+revision = 'whynote_s0_v1'
+down_revision = 'd4c1a8e37b62'
+branch_labels = None
+depends_on = None
+
+
+def upgrade():
+    op.add_column('feedback', sa.Column('association_version', sa.Integer(), nullable=True))
+    op.add_column('feedback', sa.Column('verified_chat_id', sa.Text(), nullable=True))
+    op.add_column('feedback', sa.Column('verified_message_id', sa.Text(), nullable=True))
+    review = op.create_table(
+        'whynote_feedback_review',
+        sa.Column('feedback_id', sa.Text(), primary_key=True),
+        sa.Column('reason', sa.Text(), nullable=False),
+    )
+    # Leave every existing feedback row unchanged and untrusted.
+    feedback = sa.table('feedback', sa.column('id', sa.Text()))
+    op.get_bind().execute(
+        review.insert().from_select(
+            ['feedback_id', 'reason'], sa.select(feedback.c.id, sa.literal('legacy_unverified'))
+        )
+    )
+
+
+def downgrade():
+    # Export the review queue before downgrade; metadata loss cannot be undone.
+    op.drop_table('whynote_feedback_review')
+    with op.batch_alter_table('feedback') as batch:
+        batch.drop_column('verified_message_id')
+        batch.drop_column('verified_chat_id')
+        batch.drop_column('association_version')
